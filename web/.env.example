# Better Auth — required environment (copy to `.env` and fill in).
# Never commit `.env`; this example documents the required keys only.

# High-entropy secret, min 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Base URL of the app (used for cookies and links).
BETTER_AUTH_URL=http://localhost:3000

# Optional: override the auth SQLite path (defaults to ./data/tieout-auth.db).
# TIEOUT_AUTH_DB=./data/tieout-auth.db